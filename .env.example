# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Any Gemini model that's free on the Developer API. gemini-3.5-flash-lite is
# the recommended default: GA (not preview), free tier, 1M context, and it's
# Google's own suggested replacement for the older 2.5-flash line, which now
# 404s ("no longer available to new users") for freshly created API keys.
# Swap to gemini-3.5-flash for stronger reasoning at a higher $0 rate limit
# cost, or gemini-2.5-flash-lite if you specifically need it (note: Google
# has a shutdown notice on 2.5-flash-lite for Oct 16, 2026).
GEMINI_MODEL=gemini-3.5-flash-lite

# Free-tier RPM is small (single digits to ~15 depending on model/date).
# This throttles our own outgoing calls so we don't get 429s mid-run.
# Check https://ai.google.dev/gemini-api/docs/rate-limits for your model's
# current number and adjust.
GEMINI_MAX_REQUESTS_PER_MINUTE=8

# Hard cap on how many files get an LLM pass in one run. Static regex/HTML
# checks run on every file for free; this cap only limits the *paid-in-quota*
# LLM step. See README "Why there's a file cap" before raising it.
MAX_FILES_FOR_LLM=40

# SQLite file for run history
DATABASE_PATH=./bugcheck.db

# Where uploaded zips are extracted (ephemeral, cleaned after each run)
UPLOAD_TMP_DIR=./tmp_uploads

# Where timestamped reports are written
REPORTS_DIR=./reports
