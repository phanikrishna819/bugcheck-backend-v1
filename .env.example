# ---------------------------------------------------------------------------
# LLM providers. Set at least one key. Both can be set: the agent picks a
# provider per purpose and falls back to the other if the first one fails.
# ---------------------------------------------------------------------------
# auto | openai | gemini
# auto -> chat prefers OpenAI tool calling, the scan pass prefers Gemini's
#         free tier, with the other provider as a fallback.
LLM_PROVIDER=auto
# Optional per-purpose overrides:
# LLM_CHAT_PROVIDER=openai
# LLM_SCAN_PROVIDER=gemini
# LLM_CHAT_MODEL=
# LLM_SCAN_MODEL=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Gemini's OpenAI-compatible surface, used by the chat tool loop.
GEMINI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Free-tier RPM is small. Throttles the scan pass so a big upload degrades to
# "slower" instead of a wall of 429s.
GEMINI_MAX_REQUESTS_PER_MINUTE=8

# ---------------------------------------------------------------------------
# Agent limits
# ---------------------------------------------------------------------------
# Blank -> bundled app/assets (bugcheck.agent.md + skills/).
AGENT_ASSETS_DIR=
AGENT_MAX_TOOL_ROUNDS=8
AGENT_TEMPERATURE=0.1
AGENT_MAX_OUTPUT_CHARS=24000
AGENT_MAX_HISTORY_MESSAGES=40
AGENT_MAX_FILE_BYTES=256000
AGENT_MAX_WALK_DEPTH=8

# Shell tool. Set AGENT_ALLOW_SHELL=false in production to remove
# run_command entirely; the allowlist below is a second line of defence.
AGENT_ALLOW_SHELL=true
AGENT_ALLOWED_COMMANDS=git,ls,dir,cat,type,find,grep,rg,head,tail,wc,python,python3,pip,node,npm,npx,pnpm,yarn,mvn,gradle,pytest,jest,vitest,tsc,eslint,ng,dotnet,go,cargo,rustc,javac,java
AGENT_COMMAND_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Workspaces: local path or git URL (shallow-cloned into WORKSPACE_DIR).
# both | local | clone
# ---------------------------------------------------------------------------
WORKSPACE_MODE=both
WORKSPACE_DIR=./tmp_workspaces
CLONE_TIMEOUT_SECONDS=180
CLONE_MAX_REPO_MB=500

# ---------------------------------------------------------------------------
# Chat sessions (SQLite) and HTTP
# ---------------------------------------------------------------------------
SESSION_TTL_MINUTES=720
# Files given an AI pass when building the on-demand PDF fix report.
PDF_MAX_FILES_FOR_LLM=12
DATABASE_PATH=./bugcheck.db
# Comma-separated origins; * for local dev. In production set the frontend
# origin, e.g. https://bugcheck-agent-chatbot-frontend.onrender.com
CORS_ALLOW_ORIGINS=*

# ---------------------------------------------------------------------------
# Upload/scan pipeline
# ---------------------------------------------------------------------------
# Hard cap on how many files get an LLM pass in one run.
MAX_FILES_FOR_LLM=40
MAX_UPLOAD_MB=200
# Zip-bomb guards for extracted archives.
MAX_EXTRACTED_MB=500
MAX_EXTRACTED_FILES=20000
UPLOAD_TMP_DIR=./tmp_uploads
REPORTS_DIR=./reports
